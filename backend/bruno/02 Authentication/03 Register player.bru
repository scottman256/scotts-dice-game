meta {
  name: Register player
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{registrationUsername}}",
    "email": "{{registrationEmail}}",
    "password": "{{registrationPassword}}",
    "passwordConfirmation": "{{registrationPassword}}"
  }
}

script:pre-request {
  const username = bru.getEnvVar("registrationUsername") || "bruno-" + Date.now();
  bru.setVar("registrationUsername", username);
  bru.setVar("registrationEmail", bru.getEnvVar("registrationEmail") || username + "@example.com");
  bru.setVar("managedUserId", "");
  bru.setVar("playerToken", "");
}

script:post-response {
  if (res.status === 201 && res.body.user.admin === false) {
    bru.setVar("playerToken", res.body.accessToken);
    bru.setVar("playerUserId", res.body.user.id);
    bru.setVar("managedUserId", res.body.user.id);
  }
}

tests {
  test("Returns HTTP 201", function () {
    expect(res.status).to.equal(201);
  });

  test("Creates and signs in a non-admin player", function () {
    expect(res.body.user.admin).to.equal(false);
    expect(res.body.user.username).to.equal(req.getBody().username);
    expect(res.body.accessToken).to.be.a("string").and.not.empty;
  });
}

docs {
  Creates a disposable player and replaces playerToken for the remaining scenario; adminToken stays separate.
  Leave registrationUsername and registrationEmail empty in Local to generate unique values each run,
  or fill them in to use your own data. Username: 3-32 letters/digits/periods/underscores/hyphens,
  starting with a letter or digit. Email must be valid and unique. Password: 12-72 characters,
  uppercase, lowercase, number, symbol, no whitespace; confirmation must match.
  Duplicate username/email returns 409. Admin cleanup uses the captured managedUserId.
}
