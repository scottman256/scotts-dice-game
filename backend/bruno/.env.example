# Copy to .env in this folder. Bruno loads it automatically.
# These are the application's documented local seed accounts.
DICE_PLAYER_IDENTIFIER=test
DICE_PLAYER_PASSWORD=test
DICE_ADMIN_IDENTIFIER=admin
DICE_ADMIN_PASSWORD=admin

# Example passwords meet the API's 12-72 character password policy.
DICE_REGISTER_PASSWORD=Bruno-Example-2026!
DICE_NEW_PASSWORD=Bruno-Updated-2026!

# Optional existing application tokens. Login requests usually supply these
# in memory instead; never paste real tokens into tracked .bru files.
DICE_PLAYER_TOKEN=
DICE_ADMIN_TOKEN=

# Optional Firebase ID token from Google/Facebook sign-in in the configured
# Firebase project. This is an ID token, not an application access token.
DICE_FIREBASE_ID_TOKEN=
