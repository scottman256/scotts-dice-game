meta {
  name: Change managed user password
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/api/admin/users/{{managedUserId}}/password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "{{newPassword}}",
    "passwordConfirmation": "{{newPassword}}"
  }
}

script:pre-request {
  const userId = bru.getVar("managedUserId") || bru.getEnvVar("managedUserId");
  if (!userId) throw new Error("Run Register player first or set managedUserId explicitly.");
  bru.setVar("managedUserId", userId);
}

tests {
  test("Returns HTTP 204", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Administrator only, manual accounts only. Set DICE_NEW_PASSWORD in .env. Password policy:
  12-72 characters, uppercase, lowercase, number, symbol, no whitespace; both values must match.
  This changes the target account password. Google/Facebook credentials are provider-managed.
}
